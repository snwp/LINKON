{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janela principal do Linkon",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/library/**" }]
    }
  ]
}
